# 启动：mainline 的 SPI 是 dm-spi（没有 0xBF000000 XIP），所以先 sf read 再 bootm
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="sf probe 0 50000000; sf read 0x83000000 0x50000 0x400000; bootm 0x83000000"
