--flash NOR
--mtdparts "192k(u-boot),64k(kpanic),64k(factory),-(firmware)"
--model "OrayBox_X5-2253"
--kernel-offset 0x50000
# reset -> bank@0 a18
--reset-pin 18
# hc:green:extra -> bank@0 a6
--sysled-pin 6
# hc:green:wifi -> bank@0 a7
--sysled2-pin 7
# ram MB 来源: 板名后缀 -S256
# 原厂 u-boot 内嵌 dramc 基线表: DDR2_512M（SDK 运行时按实际颗粒改写，别照搬）
# cpufreq 依据: MT7621A 标称默认（已验证 5 块板 DTB cpuclock=880MHz），未逐一实测
--cpufreq 880
# ramfreq 依据: 仓库 Kconfig 默认 1200 MT/s（原厂 blob 未匹到频率立即数，DDR3 常用档）
--ramfreq 1200
--ddrparam DDR3-256MiB
--oldparam false
--baudrate 115200
--yes
# mtdparts 来源: 继承 ORH/260
