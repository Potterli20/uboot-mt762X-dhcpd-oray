--flash NAND
--mtdparts "512k(u-boot),512k(u-boot-env),256k(factory),512k(bdinfo),512k(kpanic),-(firmware)"
--model "OrayBox_X5-6256"
--kernel-offset 0x240000
# reset -> bank@0 a18
--reset-pin 18
# oraybox:red:status -> bank@0 a7
--sysled-pin 7
# oraybox:green:status -> bank@0 a8
--sysled2-pin 8
# ram MB 来源: 板名后缀 -N256
# 原厂 u-boot 内嵌 dramc 基线表: DDR2_512M（SDK 运行时按实际颗粒改写，别照搬）
# cpufreq 依据: MT7621A 标称默认（已验证 5 块板 DTB cpuclock=880MHz），未逐一实测
--cpufreq 880
# ramfreq 依据: 仓库 Kconfig 默认 1200 MT/s（原厂 blob 未匹到频率立即数，DDR3 常用档）
--ramfreq 1200
--ddrparam DDR3-256MiB
--oldparam false
--baudrate 115200
--yes
# mtdparts 来源: DTB
